#!/bin/bash
# Dobbeltklikk-starteren.
#
# Spør etter fila med den vanlige «velg fil»-ruta på Mac, og åpner tabellen i
# nettleseren. Ingen terminal involvert.
#
# Koden ligger inne i appen, i Contents/Resources. Det er med vilje: macOS
# kopierer nedlastede apper til et midlertidig, skrivebeskyttet sted og kjører
# dem derfra – uten mappa rundt (det heter App Translocation). En app som leter
# etter filer ved siden av seg selv, finner dem ikke da. En app som har dem med
# seg, virker uansett hvor den ligger og uansett hvor den blir kopiert.

LOGG="$HOME/Library/Logs/fmscout.log"
mkdir -p "$(dirname "$LOGG")"

logg() { echo "$(date '+%Y-%m-%d %H:%M:%S')  $*" >>"$LOGG"; }

varsle() {   # tittel, tekst
  /usr/bin/osascript \
    -e 'on run {tittel, tekst}' \
    -e 'tell application "System Events" to activate' \
    -e 'display dialog tekst with title tittel buttons {"OK"} default button 1 with icon caution' \
    -e 'end run' \
    -- "$1" "$2" >/dev/null 2>&1
}

sporr_ja_nei() {   # tittel, tekst, ja-knapp -> 0 hvis ja
  /usr/bin/osascript \
    -e 'on run {tittel, tekst, ja}' \
    -e 'tell application "System Events" to activate' \
    -e 'display dialog tekst with title tittel buttons {"Avbryt", ja} default button 2' \
    -e 'end run' \
    -- "$1" "$2" "$3" >/dev/null 2>&1
}

KODE="$(cd "$(dirname "$0")/../Resources" 2>/dev/null && pwd)"
if [ -z "$KODE" ] || [ ! -f "$KODE/fmscout.py" ]; then
  logg "koden mangler i appen. Startet fra: $0"
  varsle "FM Scout" "Appen er ufullstendig – koden mangler inni den.

Det skjer som regel om bare selve appen er kopiert ut av en zip-fil i stedet for hele mappa. Last ned på nytt, og dobbeltklikk zip-fila så den pakkes ut i sin helhet."
  exit 1
fi

# --- hvilken Python? --------------------------------------------------------
PY=""
KANDIDATER=(/opt/homebrew/bin/python3 /usr/local/bin/python3)
# /usr/bin/python3 er bare et skall før Xcode-verktøya er installert – å kjøre
# det da spretter opp en installasjonsrute. Derfor sjekker vi først.
if /usr/bin/xcode-select -p >/dev/null 2>&1; then
  KANDIDATER+=(/usr/bin/python3)
fi
for kandidat in "${KANDIDATER[@]}"; do
  if [ -x "$kandidat" ] && "$kandidat" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    PY="$kandidat"
    break
  fi
done

if [ -z "$PY" ]; then
  logg "fant ingen brukbar python3"
  if sporr_ja_nei "FM Scout" "FM Scout trenger Python 3, og det ligger ikke på maskinen ennå.

Last det ned fra python.org, installer, og start FM Scout på nytt." "Åpne python.org"; then
    /usr/bin/open "https://www.python.org/downloads/macos/"
  fi
  exit 1
fi

# --- hvilken fil? -----------------------------------------------------------
FIL="$(/usr/bin/osascript <<'AS' 2>/dev/null
tell application "System Events" to activate
set valgt to choose file with prompt "Velg FM-saven (.fm) eller en eksport fra FM"
POSIX path of valgt
AS
)"

[ -z "$FIL" ] && exit 0        # Avbryt

# --- i gang -----------------------------------------------------------------
logg ""
logg "=== $FIL"
logg "kode: $KODE · python: $PY"

cd "$KODE" || exit 1
"$PY" fmscout.py åpne "$FIL" >>"$LOGG" 2>&1
kode=$?

if [ $kode -ne 0 ] && [ $kode -ne 130 ]; then
  siste=$(tail -n 6 "$LOGG" | tr -d '"')
  varsle "FM Scout" "Noe gikk galt.

$siste

Hele loggen: $LOGG"
  exit $kode
fi
